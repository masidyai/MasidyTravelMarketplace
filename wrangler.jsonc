{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masidytravelmarketplace",
  "main": ".open-next/worker.js",
  "account_id": "e0de3cfc84733483abd97dc50b30ef01",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "AUTH_URL": "https://masidy.travel",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "travel-marketplace-production",
      "database_id": "187f344f-a995-441f-b698-6779f5ac9b13",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "travel-marketplace-media",
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "travel-marketplace-cache",
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "masidytravelmarketplace",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
